# Documentation only: export these values in your shell; no dotenv loader is used.
VAULTPANEL_STORAGE_MOUNT=/
VAULTPANEL_SNAPSHOT_DIR=
VAULTPANEL_STATE_DIR=state
VAULTPANEL_SMART_DEVICES=
VAULTPANEL_SERVICES=[]
VAULTPANEL_COMMAND_READS=false
VAULTPANEL_PING_TARGET=
VAULTPANEL_DNS_TARGET=
# Optional local browser authentication; generate your own value and keep it private.
VAULTPANEL_ACCESS_TOKEN=
