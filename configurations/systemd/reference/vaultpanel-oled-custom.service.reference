# REFERENCE ONLY — NOT AN INSTALLABLE OR VALIDATED UNIT
# Deployment account replaced with the neutral name vaultpanel.
# See ../../../docs/SERVICE_AUDIT.md before adapting this material.
[Unit]
Description=VaultPanel Custom OLED
After=network.target

[Service]
Type=simple
User=vaultpanel
ExecStart=/opt/vaultpanel/scripts/vaultpanel_oled_custom.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
